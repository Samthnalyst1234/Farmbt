# Copy this file to .env and fill in ONE key. The farm uses whichever it finds (Claude first).
ANTHROPIC_API_KEY=      # from https://platform.claude.com
XAI_API_KEY=            # from https://console.x.ai (Grok)
GROQ_API_KEY=           # from https://console.groq.com (Groq, free tier)

# Optional settings
# FARM_PROVIDER=grok                       # force a provider when both keys are set: claude | grok
# FARM_MAX_COST=5                          # USD per session before the farm pauses (0 = no limit)
# FARM_QUESTIONS=5                         # research questions per run
# FARM_WORKERS=4                           # researchers working at once
# FARM_MODEL=claude-opus-5                 # model for every agent (default: claude-opus-5, or grok-4.7 for Grok)
# FARM_MODEL_RESEARCHER=claude-sonnet-5    # cheaper model for one role (researcher, extractor, critic, ...)
# FARM_EFFORT_GAP_HUNTER=max               # think harder in one role (Claude only)
